<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <target xsi:type="File" name="ownFile-web" fileName="c:\temp\nlog-own-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}" />
    
    <target type='WebService'
            name='ws'
            url='https://wnt7p9n8cb.execute-api.us-east-1.amazonaws.com/default/spc'
            protocol='JsonPost'
            encoding='UTF-8'>
      <header name='x-api-key' layout='d0NMHFNXfQ15D8b5qQjyb5D7z8AdYPoZ87RirlJb' />
      
      <parameter name='@timestampUTC' type='System.String' layout='${date:universalTime=true:format=MMMM dd yyyy HH\:mm\:ss.fff:culture=en-US}' />
      <parameter name='Level' type='System.String' layout='${level}'/>
      
      <!-- Custom properties. See NLog Wiki page https://github.com/NLog/NLog/wiki/EventProperties-Layout-Renderer -->
      <!--<parameter name="Prop1" type='System.String' layout="${event-properties:custom}" />-->
      <!--<parameter name="Id1" type='System.String' layout="${event-properties:custom:objectpath=Id}" />-->
      
      <!--Request Data-->
      <!--<parameter name='CorrelationId' type='System.String' layout='${threadid}'/>-->
      <!--<parameter name='TenantId' type='System.String' layout='${event-properties:custom:objectpath=TenantId}'/>-->
      <!--<parameter name="User" type='System.String' layout="${aspnet-user-identity}"/>-->
      <!--<parameter name="Browser" type='System.String' layout="${aspnet-request-useragent}"/>-->
      <!--<parameter name="IPAddress" type='System.String' layout="${aspnet-request-ip}"/>-->
      <!--<parameter name='Url' type='System.String' layout='${aspnet-request-url}'/>-->
      <!--<parameter name='Action' type='System.String' layout='${aspnet-mvc-action}'/>-->

      <!--Environment-->
      <!--<parameter name='ProductId' type='System.String' layout="${literal:text=ProductId}" />-->
      <!--<parameter name='ProductVersion' type='System.String' layout="${literal:text=ProductVersion}" />-->
      <!--<parameter name='Component' type='System.String' layout="${literal:text=Component}" />-->
      <!--<parameter name='ComponentVersion' type='System.String' layout="${literal:text=ComponentVersion}" />-->
      
      <!--ExecutionData-->
      <parameter name="ComputerName" type='System.String' layout="${machinename}" />
      <parameter name='Exception' type='System.String' layout='${exception:format=ToString,StackTrace}${newline}'/>
      <!--<parameter name="ProcessId" type='System.String' layout="${processid}" />-->
      <!--<parameter name="ProcessName" type='System.String' layout="${processname}" />-->
      <!--<parameter name="Thread" type='System.String' layout="${threadid}" />-->
      <!--<parameter name="Callsite" type='System.String' layout="${callsite:className=true:fileName=true:includeSourcePath=true:methodName=true}" />-->
      
      <!--MessageData-->
      <parameter name='message' type='System.String' layout='${message}'/>
      <parameter name='messageId' type='System.String' layout='${guid}'/>

    </target>
  </targets>

  <!-- rules to map from logger name to target -->
  <rules>
    <!--All logs, including from Microsoft-->
    <logger name="*" minlevel="Error" writeTo="ws" />
    <!--Skip Microsoft logs and so log only own logs-->
    <logger name="Microsoft.*" maxlevel="Info" final="true" /> <!-- BlackHole without writeTo -->
  </rules>
</nlog>